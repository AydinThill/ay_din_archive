{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/archive/",
      "permanent": false
    },
    {
      "source": "/linktree",
      "destination": "/archive/",
      "permanent": true
    },
    {
      "source": "/linktree/",
      "destination": "/archive/",
      "permanent": true
    },
    {
      "source": "/linktree/:path*",
      "destination": "/archive/:path*",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/archive/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/admin/static/:path*"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/archive/",
      "destination": "/index.html"
    },
    {
      "source": "/archive/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/archive/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/archive/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
